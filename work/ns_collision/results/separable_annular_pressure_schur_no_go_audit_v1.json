  "analytic_theorem_certificate": {
    "Fisher_proof": {
      "cell_Cauchy_bound": "sum||Delta_1Delta_2Delta_3 F_N||^2 <=(N+1)^-3 integral||partial_123 f_N||^2",
      "conclusion": "E_lambda(h_N)<=C_F*(N+1)^-3",
      "exact_identity": "E_lambda(h_N)=(1/32) sum_cells ||Delta_1 Delta_2 Delta_3 F_N||_F^2",
      "exact_one_dimensional_identity_checked": true,
      "gauged_grid_tensor": "F_N(a,b,c)=S(t) M(Xi_N(t)), t=(a,b,c)/(N+1)",
      "smooth_embedding": "Xi_N(t)=(2-1/N+(1+1/N)t1,(1+1/N)(t2-1/2),(1+1/N)(t3-1/2))",
      "uniform_derivative_reason": "Xi_N([0,1]^3) stays in one compact set separated from zero for N>=3, and M(xi)=xi tensor P_xi(e_3)/|xi| is smooth there"
    },
    "all_checks_pass": true,
    "annulus_proof": {
      "maximum_frequency_bound": "|k|<sqrt(19/2)N",
      "minimum_frequency_bound": "|k|>=2N",
      "same_sign_vertex_alias_excluded": true,
      "shell_ratio_bound": "sqrt(19/8)<2"
    },
    "complete_flux_proof": {
      "conclusion": "B_complete_HHL/N has the same strictly negative limit as B_pressure_HH/N.",
      "cross_pressure": "Each p[U,h_k] is O(N^-2), multiplication by the second O(N^-1) high coefficient gives O(N^-3) per pair, and only O(N^3) resonant pairs occur; hence B_cross=O(1)=o(N).",
      "kinetic": "After division by N the finite-difference sums are Riemann sums. Their pointwise leading quadratic matrix sums exactly to zero over the two low signs, hence B_kinetic=o(N).",
      "kinetic_leading_matrix_exactly_zero": true
    },
    "family": {
      "coefficient": "alpha_abc=(-1)^(a+b+c) sin(pi*a/(N+1)) sin(pi*b/(N+1)) sin(pi*c/(N+1))",
      "fixed_low_wave": "(0,1,-1)",
      "fixed_positive_low_coefficient": "-i(e_2+e_3)/sqrt(2)",
      "index_set": "1<=a,b,c<=N, N odd",
      "positive_velocity": "hhat_N(k_abc)=alpha_abc P_k(e_3)/|k_abc|",
      "positive_wave": "k_abc=(2N+a-1,b-(N+1)/2,c-(N+1)/2)",
      "reality_extension": "hhat_N(-k)=conj(hhat_N(k))",
      "vertex": "lambda(x)=product_j (1+cos(x_j))/2"
    },
    "logical_conclusion": {
      "assumed_bound_falsified": "|B_complete_HHL(h,U)| <= C ||Uhat|| E_lambda(h) with C independent of the annular dimension N",
      "homogeneity_note": "Both sides are quadratic in h, so any desired nonzero normalization of h leaves the divergent ratio unchanged."
    },
    "pressure_limit_proof": {
      "Riemann_limit": "phat_N(q)/N -> -2(-1)^sum(q)/|q|^2 integral_D S^2(q dot V)^2",
      "difference_coefficient": "phat_N(q)=-(2/|q|^2) sum_k (q dot hhat_N(k))(q dot hhat_N(k-q))",
      "limit_formula": "B_pressure_HH/N -> (sqrt(2)/20) integral_D S^2(V_y^2-V_z^2)",
      "pointwise_margin": "V_z^2-V_y^2>=255/13718 on D",
      "profile_mass": "integral_D S^2=1/8",
      "quadrature_value_is_corroborative_only": -0.0014065919385788295,
      "strict_limit_bound": "lim B_pressure_HH/N <= -51*sqrt(2)/438976<0",
      "summed_exact_matrix": "diag(0,sqrt(2)/20,-sqrt(2)/20)",
      "velocity_components": "V_y=-zy/r^3, V_z=(x^2+y^2)/r^3"
    },
    "theorem": "For the fixed compatible tensor vertex lambda and fixed low wave U below, there is a real divergence-free family h_N supported in one uniformly bounded annulus such that E_lambda(h_N)=O(N^-3) and B_complete_HHL(h_N,U)/N tends to a strictly negative limit. Consequently |B_complete_HHL|/E_lambda grows at least as c*N^4, so no N-uniform joint Fisher-Schur bound of this form can hold."
  },
